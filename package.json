{
  "name": "dataviz-engine",
  "version": "1.4.2",
  "description": "Composable, accessible React charting library built on D3.js",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c --watch",
    "test": "jest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "dependencies": {
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@storybook/addon-docs": "^7.6.10",
    "@storybook/react": "^7.6.10",
    "@storybook/react-vite": "^7.6.10",
    "@testing-library/jest-dom": "^6.4.1",
    "@testing-library/react": "^14.2.1",
    "@types/d3": "^7.4.3",
    "@types/react": "^18.2.55",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rollup": "^4.10.0",
    "rollup-plugin-dts": "^6.1.0",
    "storybook": "^7.6.10",
    "typescript": "^5.3.3"
  },
  "keywords": ["react", "charts", "d3", "visualization", "typescript", "accessible"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brian-codington/dataviz-engine"
  }
}
